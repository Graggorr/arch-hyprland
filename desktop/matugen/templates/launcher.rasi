/* Generated by matugen — do not edit. App launcher theme (Super+D / $launcher).
   Edit the template at ~/.config/matugen/templates/launcher.rasi instead.
   Colours inline (no @import) so they always load regardless of CWD.

   NOTE: no `@theme` line may appear in this file. In rofi, @theme RESETS the
   theme and loads the named file, so a trailing @theme silently discards every
   rule above it — which is exactly what the old hand-written config did. */

configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Nordic-darker";
    drun-display-format: "{name}";
    display-drun:        "Apps";
    display-run:         "Run";
    display-window:      "Windows";
    /* match on the app's real name + exec, not just the display name */
    matching:            "fuzzy";
    drun-match-fields:   "name,generic,exec,categories,keywords";
    sidebar-mode:        false;
}

* {
    bg:       {{colors.surface.default.hex}};
    bg-alt:   {{colors.surface_container_high.default.hex}};
    fg:       {{colors.on_surface.default.hex}};
    muted:    {{colors.outline.default.hex}};
    accent:   {{colors.primary.default.hex}};
    accfg:    {{colors.on_primary.default.hex}};
    urgent:   {{colors.error.default.hex}};

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 11";
}

window {
    location:         center;
    width:            640px;
    border:           2px;
    border-color:     @accent;
    border-radius:    18px;
    background-color: @bg;
}

mainbox {
    padding:  20px;
    spacing:  16px;
    children: [ inputbar, listview ];
}

/* ── search field ── */
inputbar {
    background-color: @bg-alt;
    border-radius:    12px;
    padding:          12px 16px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

/* the mode name ("Apps") as an accent chip on the left */
prompt {
    text-color:     @accent;
    vertical-align: 0.5;
}

entry {
    placeholder:       "Search…";
    placeholder-color: @muted;
    text-color:        @fg;
    vertical-align:    0.5;
    cursor:            text;
}

/* ── results ── */
listview {
    lines:     8;
    columns:   1;
    scrollbar: false;
    spacing:   6px;
    fixed-height: false;
}

/* Every element state needs an EXPLICIT background-color. rofi merges its
   built-in default theme first, and that default sets backgrounds on the
   element states directly — a `background-color: transparent` in `*` does not
   override it (explicit beats inherited), which renders unselected rows as a
   cream block with unreadable text. */
element {
    padding:          10px 14px;
    border-radius:    10px;
    spacing:          12px;
    cursor:           pointer;
    background-color: transparent;
    text-color:       @fg;
}

element-icon {
    size:             28px;
    vertical-align:   0.5;
    cursor:           inherit;
    background-color: transparent;
}

element-text {
    text-color:       inherit;
    vertical-align:   0.5;
    cursor:           inherit;
    background-color: transparent;
}

element normal normal    { background-color: transparent; text-color: @fg; }
element alternate normal { background-color: transparent; text-color: @fg; }

element normal urgent    { background-color: transparent; text-color: @urgent; }
element alternate urgent { background-color: transparent; text-color: @urgent; }

element normal active    { background-color: transparent; text-color: @accent; }
element alternate active { background-color: transparent; text-color: @accent; }

element selected normal {
    background-color: @accent;
    text-color:       @accfg;
}
element selected urgent {
    background-color: @urgent;
    text-color:       @bg;
}
element selected active {
    background-color: @accent;
    text-color:       @accfg;
}

/* shown when a search matches nothing */
message {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          10px 14px;
}
textbox {
    text-color:     @fg;
    vertical-align: 0.5;
}
