/* Generated by matugen — do not edit. Full power-menu theme (theme switcher).
   Colours inline (no @import) so they always load regardless of CWD. */
* {
    bg:     {{colors.surface.default.hex}};
    fg:     {{colors.on_surface.default.hex}};
    accent: {{colors.primary.default.hex}};
    accfg:  {{colors.on_primary.default.hex}};
    background-color: transparent;
    text-color:       @fg;
}

configuration { show-icons: false; }

window {
    location: center;
    width: 320px;
    border: 2px;
    border-color: @accent;
    border-radius: 16px;
    background-color: @bg;
}

mainbox { padding: 16px; spacing: 10px; children: [ "listview" ]; }

listview { lines: 5; columns: 1; spacing: 6px; background-color: transparent; }

element {
    padding: 11px 16px;
    border-radius: 10px;
    background-color: transparent;
    text-color: @fg;
}
element-text {
    font: "JetBrainsMono Nerd Font 14";
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
element selected {
    background-color: @accent;
    text-color: @accfg;
}
