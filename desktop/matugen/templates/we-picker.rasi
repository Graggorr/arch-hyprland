/* Generated by matugen — Wallpaper Engine picker (thumbnail grid). */
* {
    bg:     {{colors.surface.default.hex}};
    bg-alt: {{colors.surface_container.default.hex}};
    fg:     {{colors.on_surface.default.hex}};
    accent: {{colors.primary.default.hex}};
    accfg:  {{colors.on_primary.default.hex}};
    background-color: transparent;
    text-color:       @fg;
}

configuration { show-icons: true; }

window {
    location: center;
    width: 70%;
    height: 68%;
    border: 2px;
    border-color: @accent;
    border-radius: 16px;
    background-color: @bg;
}

mainbox { padding: 18px; spacing: 14px; children: [ "inputbar", "listview" ]; }

inputbar {
    padding: 10px 14px;
    border-radius: 12px;
    background-color: @bg-alt;
    text-color: @fg;
    children: [ "prompt", "entry" ];
}
prompt { text-color: @accent; padding: 0 8px 0 0; }

listview { columns: 4; lines: 3; spacing: 14px; background-color: transparent; }

element {
    orientation: vertical;
    padding: 8px;
    spacing: 6px;
    border-radius: 12px;
    background-color: @bg-alt;
    text-color: @fg;
}
element-icon { size: 150px; border-radius: 8px; background-color: transparent; }
element-text {
    horizontal-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}
element selected {
    background-color: @accent;
    text-color: @accfg;
}
