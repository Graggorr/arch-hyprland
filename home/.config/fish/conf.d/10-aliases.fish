# -----------------------------------------------------
# ALIASES
# -----------------------------------------------------

alias ..='cd ..'
alias c='clear'
alias ff='fastfetch'
alias ls='eza -a --icons=always'
alias ll='eza -al --icons=always'
alias lt='eza -a --tree --level=1 --icons=always'
alias v='$EDITOR'
alias shutdown='systemctl poweroff'
alias wifi='nmtui'
alias system='btop'
alias screenshot='grimblast --notify copysave area'
alias wallpaper='waypaper'
alias lock='qs ipc call lock lock'
alias config='cd ~/.config'
