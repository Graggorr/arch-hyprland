#!/usr/bin/env python3
"""Create a calendar event from JSON on stdin.

Built with the icalendar library rather than `khal new` because khal has no
way to set ATTENDEE. The VEVENT is written straight into the local vdir
collection and pushed by a vdirsyncer sync; both Google and iCloud mail the
invitations themselves once an event arrives carrying ORGANIZER + ATTENDEE.

Input:
  {"calendar":"<collection dir>", "title":"...", "date":"YYYY-MM-DD",
   "start":"HH:MM", "end":"HH:MM", "allday":false, "location":"",
   "description":"", "alarm":10, "attendees":["a@b.com"]}

Output: {"ok":true,"uid":"...","path":"...","synced":true}
"""
import datetime as dt
import json
import os
import subprocess
import sys
import uuid
from pathlib import Path
from zoneinfo import ZoneInfo

ROOT = Path(os.environ.get("CAL_ROOT", Path.home() / ".local/share/calendars")).expanduser()
TZ = ZoneInfo(os.environ.get("CAL_TZ") or os.path.realpath("/etc/localtime").split("zoneinfo/")[-1])
SYNC = os.environ.get("CAL_SYNC", "1") != "0"
TIMEOUT = float(os.environ.get("CAL_TIMEOUT", "60"))

# Which vdirsyncer pair owns a given account dir, so only that one is synced.
ACCOUNT_PAIR = {
    "google-personal": "google_personal",
    "icloud": "icloud",
    "icloud-reminders": "icloud_reminders",
}

# Subscribed ICS feeds are mirrors: vdirsyncer reverts anything written into
# them on the next sync, so refuse rather than lose the event silently.
READONLY_ACCOUNTS = {"subscriptions"}


def find_collection(name):
    for acct in sorted(ROOT.iterdir()) if ROOT.is_dir() else []:
        if not acct.is_dir():
            continue
        d = acct / name
        if d.is_dir():
            return acct.name, d
    return None, None


def organizer_for(account, collection):
    """The address the account authenticates as, used as ORGANIZER.

    Google names a collection after its calendar id, and the primary
    calendar's id is the account's own address — so for the common case the
    organizer is simply the collection name. iCloud uses opaque ids, so that
    one comes from the Apple ID in the keyring.
    """
    override = os.environ.get("CAL_ORGANIZER")
    if override:
        return override
    if "@" in collection and "." in collection.split("@")[-1]:
        return collection
    if account.startswith("icloud"):
        try:
            p = subprocess.run(
                ["secret-tool", "lookup", "service", "vdirsyncer-icloud", "key", "username"],
                capture_output=True, text=True, timeout=10)
            return p.stdout.strip() if p.returncode == 0 else ""
        except (FileNotFoundError, subprocess.TimeoutExpired):
            return ""
    return ""


def build(spec, organizer):
    from icalendar import Alarm, Calendar, Event, vCalAddress, vText

    uid = f"{uuid.uuid4()}"
    cal = Calendar()
    cal.add("prodid", "-//quickshell dynamic island//EN")
    cal.add("version", "2.0")
    cal.add("method", "REQUEST" if spec.get("attendees") else "PUBLISH")

    ev = Event()
    ev.add("uid", uid)
    ev.add("summary", spec.get("title") or "(no title)")
    ev.add("dtstamp", dt.datetime.now(dt.timezone.utc))

    date = dt.date.fromisoformat(spec["date"])
    if spec.get("allday"):
        end_date = dt.date.fromisoformat(spec["endDate"]) if spec.get("endDate") else date
        ev.add("dtstart", date)
        ev.add("dtend", end_date + dt.timedelta(days=1))
    else:
        sh, sm = (int(x) for x in spec.get("start", "09:00").split(":"))
        eh, em = (int(x) for x in spec.get("end", "10:00").split(":"))
        start = dt.datetime.combine(date, dt.time(sh, sm), TZ)
        end = dt.datetime.combine(date, dt.time(eh, em), TZ)
        if end <= start:
            end += dt.timedelta(days=1)
        ev.add("dtstart", start)
        ev.add("dtend", end)

    if spec.get("location"):
        ev.add("location", spec["location"])
    if spec.get("description"):
        ev.add("description", spec["description"])

    attendees = [a.strip() for a in spec.get("attendees", []) if a and a.strip()]
    if attendees:
        if organizer:
            org = vCalAddress(f"MAILTO:{organizer}")
            org.params["cn"] = vText(organizer)
            ev.add("organizer", org)
        for addr in attendees:
            at = vCalAddress(f"MAILTO:{addr}")
            at.params["cn"] = vText(addr)
            at.params["role"] = vText("REQ-PARTICIPANT")
            at.params["partstat"] = vText("NEEDS-ACTION")
            at.params["rsvp"] = vText("TRUE")
            ev.add("attendee", at, encode=0)

    alarm_min = spec.get("alarm")
    if alarm_min not in (None, "", 0, "0"):
        al = Alarm()
        al.add("action", "DISPLAY")
        al.add("description", spec.get("title") or "Reminder")
        al.add("trigger", dt.timedelta(minutes=-int(alarm_min)))
        ev.add_component(al)

    cal.add_component(ev)
    return uid, cal.to_ical()


def sync(pair):
    if not SYNC or not pair:
        return False, "skipped"
    try:
        p = subprocess.run(["vdirsyncer", "sync", pair],
                           capture_output=True, text=True, timeout=TIMEOUT)
    except FileNotFoundError:
        return False, "vdirsyncer not installed"
    except subprocess.TimeoutExpired:
        return False, "sync timed out"
    if p.returncode != 0:
        msg = (p.stderr or p.stdout or "").strip().splitlines()
        return False, msg[-1] if msg else "sync failed"
    return True, ""


def main():
    try:
        spec = json.load(sys.stdin)
    except json.JSONDecodeError as e:
        json.dump({"ok": False, "error": f"bad input: {e}"}, sys.stdout)
        print()
        return 2

    name = spec.get("calendar", "")
    account, coll = find_collection(name)
    if not coll:
        json.dump({"ok": False, "error": f"unknown calendar: {name or '(none)'}"}, sys.stdout)
        print()
        return 1

    if account in READONLY_ACCOUNTS:
        json.dump({"ok": False, "error": f"{name} is a subscribed calendar (read-only)"}, sys.stdout)
        print()
        return 1

    if not spec.get("date"):
        json.dump({"ok": False, "error": "no date given"}, sys.stdout)
        print()
        return 1

    try:
        uid, data = build(spec, organizer_for(account, name))
    except Exception as e:
        json.dump({"ok": False, "error": f"could not build event: {e}"}, sys.stdout)
        print()
        return 1

    path = coll / f"{uid}.ics"
    try:
        path.write_bytes(data)
    except OSError as e:
        json.dump({"ok": False, "error": f"could not write: {e}"}, sys.stdout)
        print()
        return 1

    synced, err = sync(ACCOUNT_PAIR.get(account))
    out = {"ok": True, "uid": uid, "path": str(path), "calendar": name,
           "account": account, "synced": synced}
    if err:
        out["syncError"] = err
    json.dump(out, sys.stdout, ensure_ascii=False)
    print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
